cd ~/email-security-idps

cat > .gitignore <<'EOF'
# Python
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials/

# SQLite / runtime data
*.db
*.sqlite
*.sqlite3
data/

# Uploaded emails / quarantine
quarantine/
uploads/
tmp/
*.eml
*.msg

# Frontend
frontend/node_modules/
frontend/dist/

# Logs
*.log
logs/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Backups / temporary files
*.bak
*.backup
*.before-*
*.tmp

# Generated reports
backend/reports/

# Test / malicious sample files
*.exe

# Archives
*.zip
EOF
